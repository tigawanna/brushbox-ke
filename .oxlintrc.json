{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "jsx-a11y",
    "nextjs"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-empty-object-type": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "no-empty-pattern": "off",
    "nextjs/no-img-element": "off",
    "jsx_a11y/anchor-is-valid": "warn",
    "jsx_a11y/img-redundant-alt": "warn",
    "jsx_a11y/click-events-have-key-events": "warn",
    "jsx_a11y/no-static-element-interactions": "warn",
    "jsx_a11y/prefer-tag-over-role": "warn",
    "jsx_a11y/anchor-has-content": "warn",
    "jsx_a11y/no-redundant-roles": "warn",
    "jsx_a11y/alt-text": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "unicorn/no-empty-file": "warn"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".next",
    "out",
    "node_modules",
    "pnpm-lock.yaml",
    "next-env.d.ts"
  ]
}
